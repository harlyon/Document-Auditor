# Copy to .env.local and set to match the backend's API_KEY env var.
# Leave unset (or delete this file) for local dev against a backend that
# also has no API_KEY set -- auth is disabled on both sides by default.
VITE_API_KEY=

# The backend's base URL. Leave unset for local dev (defaults to
# http://localhost:8000). Set to the deployed backend's real URL for a
# production build, e.g. https://ai-document-auditor-api.onrender.com
VITE_API_BASE_URL=
